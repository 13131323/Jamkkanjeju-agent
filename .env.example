STORED_LOCATIONS_API_URL=http://localhost:8080/api/v2/agent/locations
# Spring과 동일한 에이전트 전용 비밀 토큰. Bearer 접두사 없이 설정합니다.
AGENT_API_TOKEN=

# Gemini Developer API 인증키. 실제 값은 .env에만 저장합니다.
GOOGLE_API_KEY=
# 무료 등급을 지원하는 모델. 실제 한도·과금은 계정 설정을 따릅니다.
GEMINI_MODEL=gemini-3.5-flash-lite

KTO_BASE_URL=https://apis.data.go.kr/B551011/KorService2
KTO_SERVICE_KEY=
KTO_MOBILE_OS=ETC
KTO_MOBILE_APP=jamkkanjeju

# 추후 구현할 Spring 에이전트 전용 점검 예약 API
MAINTENANCE_API_URL=http://localhost:8080/api/v2/agent/maintenances
